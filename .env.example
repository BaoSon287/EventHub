JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000
INTERNAL_API_KEY=change-me-internal-api-key

POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub

RABBITMQ_USERNAME=eventhub
RABBITMQ_PASSWORD=eventhub

VITE_API_BASE_URL=http://localhost:8080

# Optional production image storage. If set, event-service uploads event images
# to Cloudinary instead of Render/local filesystem.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=eventhub/events

# API Gateway upstream service URLs.
# For local Docker Compose, these are service names on the compose network.
# On Render, set these to each service's public https://*.onrender.com URL.
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
EVENT_SERVICE_URL=http://event-service:8083
BOOKING_SERVICE_URL=http://booking-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8085
PAYMENT_SERVICE_URL=http://payment-service:8086
